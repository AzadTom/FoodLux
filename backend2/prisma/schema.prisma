generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas=["ecommerce"]
}

model Product {
  id String @id @default(uuid()) @db.Uuid()
  name String
  slug String @unique
  heading String?
  subheading String?
  description String?
  image String 
  price Decimal 
  stock Int @default(0)
  rating Decimal @default(0) 
  status ProductStatus @default(ACTIVE)
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("ecommerce")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT

  @@schema("ecommerce")
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  image    String @default("")
  products Product[]

  @@schema("ecommerce")
}



